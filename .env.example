# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: URL for your free Supabase PostgreSQL database project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://xyzcompany.supabase.co

# SUPABASE_ANON_KEY: Public Anon Key for your Supabase project (from Project Settings -> API)
SUPABASE_ANON_KEY=your-supabase-anon-key
